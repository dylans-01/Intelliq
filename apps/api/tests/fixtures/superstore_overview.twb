<!--
  HAND-AUTHORED TEST FIXTURE. Structure follows Tableau 2023.x workbook XML
  (datasources, metadata-records, column-instances, shelves, zones, actions),
  but it was written by hand, not saved by Tableau Desktop. Real workbooks
  must be used to validate importer fidelity (see docs/06-validation.md).
-->
<workbook source-build='2023.3.0 (20233.23.1017.0948)' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences />
  <datasources>
    <datasource hasconnection='false' inline='true' name='Parameters' version='18.1'>
      <aliases enabled='yes' />
      <column caption='Top N' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='5'>
        <calculation class='tableau' formula='5' />
        <range granularity='1' max='20' min='1' />
      </column>
      <column caption='Profit Threshold' datatype='real' name='[Parameter 2]' param-domain-type='all' role='measure' type='quantitative' value='0.15'>
        <calculation class='tableau' formula='0.15' />
      </column>
    </datasource>
    <datasource caption='Sample - Superstore' inline='true' name='federated.0a1b2c3' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='warehouse.example.com' name='sqlserver.1x2y3z'>
            <connection authentication='sspi' class='sqlserver' dbname='Superstore' odbc-native-protocol='' one-time-sql='' schema='dbo' server='warehouse.example.com' />
          </named-connection>
        </named-connections>
        <relation join='left' type='join'>
          <clause type='join'>
            <expression op='='>
              <expression op='[Orders].[Region]' />
              <expression op='[People].[Region (People)]' />
            </expression>
          </clause>
          <relation connection='sqlserver.1x2y3z' name='Orders' table='[dbo].[Orders]' type='table' />
          <relation connection='sqlserver.1x2y3z' name='People' table='[dbo].[People]' type='table' />
        </relation>
        <metadata-records>
          <metadata-record class='column'><remote-name>Order ID</remote-name><remote-type>130</remote-type><local-name>[Order ID]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Order Date</remote-name><remote-type>7</remote-type><local-name>[Order Date]</local-name><parent-name>[Orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Ship Date</remote-name><remote-type>7</remote-type><local-name>[Ship Date]</local-name><parent-name>[Orders]</parent-name><local-type>date</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Customer Name</remote-name><remote-type>130</remote-type><local-name>[Customer Name]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Segment</remote-name><remote-type>130</remote-type><local-name>[Segment]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Region</remote-name><remote-type>130</remote-type><local-name>[Region]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>State</remote-name><remote-type>130</remote-type><local-name>[State]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Category</remote-name><remote-type>130</remote-type><local-name>[Category]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Sub-Category</remote-name><remote-type>130</remote-type><local-name>[Sub-Category]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Sales</remote-name><remote-type>5</remote-type><local-name>[Sales]</local-name><parent-name>[Orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Profit</remote-name><remote-type>5</remote-type><local-name>[Profit]</local-name><parent-name>[Orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Quantity</remote-name><remote-type>3</remote-type><local-name>[Quantity]</local-name><parent-name>[Orders]</parent-name><local-type>integer</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Discount</remote-name><remote-type>5</remote-type><local-name>[Discount]</local-name><parent-name>[Orders]</parent-name><local-type>real</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Regional Manager</remote-name><remote-type>130</remote-type><local-name>[Regional Manager]</local-name><parent-name>[People]</parent-name><local-type>string</local-type></metadata-record>
          <metadata-record class='column'><remote-name>Postal Code</remote-name><remote-type>130</remote-type><local-name>[Postal Code]</local-name><parent-name>[Orders]</parent-name><local-type>string</local-type></metadata-record>
        </metadata-records>
      </connection>
      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Profitable?' datatype='string' name='[Calculation_0831103151444568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Profit] &gt; 0 THEN &quot;Profitable&quot; ELSE &quot;Unprofitable&quot; END' />
      </column>
      <column caption='Sales per Customer' datatype='real' name='[Calculation_5571209093911105536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Customer Name] : SUM([Sales])}' />
      </column>
      <column caption='Cumulative Sales' datatype='real' name='[Calculation_7001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))' />
      </column>
      <column caption='Above Threshold' datatype='boolean' name='[Calculation_7002]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1368249927221915648] &gt; [Parameters].[Parameter 2]' />
      </column>
      <column caption='Order Prefix' datatype='string' name='[Calculation_7003]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REGEXP_EXTRACT([Order ID], &apos;^([A-Z]+)&apos;)' />
      </column>
      <column caption='Ship Days' datatype='integer' name='[Calculation_7004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Order Date], [Ship Date])' />
      </column>
      <column caption='Sales' datatype='real' name='[Sales]' role='measure' type='quantitative' />
      <column caption='Postal Code' datatype='string' hidden='true' name='[Postal Code]' role='dimension' type='nominal' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Sales by Region'>
      <layout-options><title><formatted-text><run>Sales by Region</run></formatted-text></title></layout-options>
      <table>
        <view>
          <datasources><datasource caption='Sample - Superstore' name='federated.0a1b2c3' /></datasources>
          <datasource-dependencies datasource='federated.0a1b2c3'>
            <column datatype='string' name='[Region]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1368249927221915648]' derivation='User' name='[usr:Calculation_1368249927221915648:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <sort class='computed' column='[federated.0a1b2c3].[none:Region:nk]' direction='DESC' using='[federated.0a1b2c3].[sum:Sales:qk]' />
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            <encodings>
              <tooltip column='[federated.0a1b2c3].[usr:Calculation_1368249927221915648:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0a1b2c3].[sum:Sales:qk]</rows>
        <cols>[federated.0a1b2c3].[none:Region:nk]</cols>
      </table>
    </worksheet>
    <worksheet name='Sales Trend'>
      <table>
        <view>
          <datasources><datasource caption='Sample - Superstore' name='federated.0a1b2c3' /></datasources>
          <datasource-dependencies datasource='federated.0a1b2c3'>
            <column-instance column='[Order Date]' derivation='Month-Trunc' name='[tmn:Order Date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Segment]' derivation='None' name='[none:Segment:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='relative-date' column='[federated.0a1b2c3].[none:Order Date:qk]' first-period='-11' include-future='true' include-null='false' last-period='0' period-type-v2='month' />
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <mark class='Line' />
            <encodings><color column='[federated.0a1b2c3].[none:Segment:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.0a1b2c3].[sum:Sales:qk]</rows>
        <cols>[federated.0a1b2c3].[tmn:Order Date:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Category Mix'>
      <table>
        <view>
          <datasources><datasource caption='Sample - Superstore' name='federated.0a1b2c3' /></datasources>
          <datasource-dependencies datasource='federated.0a1b2c3'>
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Sales]' derivation='Sum' name='[pcto:sum:Sales:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <mark class='Pie' />
            <encodings>
              <color column='[federated.0a1b2c3].[none:Category:nk]' />
              <wedge-size column='[federated.0a1b2c3].[sum:Sales:qk]' />
              <text column='[federated.0a1b2c3].[pcto:sum:Sales:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name='Profit vs Sales'>
      <table>
        <view>
          <datasources><datasource caption='Sample - Superstore' name='federated.0a1b2c3' /></datasources>
          <datasource-dependencies datasource='federated.0a1b2c3'>
            <column-instance column='[Sub-Category]' derivation='None' name='[none:Sub-Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Profit]' derivation='Sum' name='[sum:Profit:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0831103151444568]' derivation='None' name='[none:Calculation_0831103151444568:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0a1b2c3].[none:Calculation_0831103151444568:nk]' context='true'>
            <groupfilter function='member' level='[none:Calculation_0831103151444568:nk]' member='&quot;Profitable&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <mark class='Circle' />
            <encodings><lod column='[federated.0a1b2c3].[none:Sub-Category:nk]' /></encodings>
          </pane>
        </panes>
        <rows>[federated.0a1b2c3].[sum:Profit:qk]</rows>
        <cols>[federated.0a1b2c3].[sum:Sales:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Customer Detail'>
      <table>
        <view>
          <datasources><datasource caption='Sample - Superstore' name='federated.0a1b2c3' /></datasources>
          <datasource-dependencies datasource='federated.0a1b2c3'>
            <column-instance column='[Customer Name]' derivation='None' name='[none:Customer Name:nk]' pivot='key' type='nominal' />
            <column-instance column='[Segment]' derivation='None' name='[none:Segment:nk]' pivot='key' type='nominal' />
            <column-instance column='[Region]' derivation='None' name='[none:Region:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_5571209093911105536]' derivation='Avg' name='[avg:Calculation_5571209093911105536:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_7002]' derivation='User' name='[usr:Calculation_7002:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0a1b2c3].[none:Region:nk]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[none:Region:nk]' member='&quot;East&quot;' />
              <groupfilter function='member' level='[none:Region:nk]' member='&quot;West&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.0a1b2c3].[sum:Sales:qk]' included-values='in-range'>
            <min>1000</min>
          </filter>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <mark class='Text' />
            <encodings>
              <text column='[federated.0a1b2c3].[sum:Sales:qk]' />
              <text column='[federated.0a1b2c3].[avg:Calculation_5571209093911105536:qk]' />
              <text column='[federated.0a1b2c3].[usr:Calculation_7002:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.0a1b2c3].[none:Customer Name:nk] / [federated.0a1b2c3].[none:Segment:nk])</rows>
        <cols />
      </table>
    </worksheet>
    <worksheet name='State Map'>
      <table>
        <view>
          <datasources><datasource caption='Sample - Superstore' name='federated.0a1b2c3' /></datasources>
          <datasource-dependencies datasource='federated.0a1b2c3'>
            <column-instance column='[State]' derivation='None' name='[none:State:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <panes>
          <pane>
            <mark class='Map' />
            <encodings>
              <lod column='[federated.0a1b2c3].[none:State:nk]' />
              <color column='[federated.0a1b2c3].[sum:Sales:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0a1b2c3].[Latitude (generated)]</rows>
        <cols>[federated.0a1b2c3].[Longitude (generated)]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name='Executive Overview'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='900' minwidth='1400' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='6000' id='2' type-v2='title' w='100000' x='0' y='0' />
          <zone h='6000' id='3' type-v2='text' w='60000' x='0' y='6000'>
            <formatted-text><run>Company performance at a glance</run></formatted-text>
          </zone>
          <zone h='6000' id='4' mode='checkdropdown' name='Sales by Region' param='[federated.0a1b2c3].[none:Region:nk]' type-v2='filter' w='20000' x='60000' y='6000' />
          <zone h='6000' id='5' name='Sales by Region' param='[Parameters].[Parameter 2]' type-v2='paramctrl' w='20000' x='80000' y='6000' />
          <zone h='40000' id='6' name='Sales by Region' w='50000' x='0' y='12000' />
          <zone h='40000' id='7' name='Sales Trend' w='50000' x='50000' y='12000' />
          <zone h='48000' id='8' name='Category Mix' w='33333' x='0' y='52000' />
          <zone h='48000' id='9' name='Profit vs Sales' w='33333' x='33333' y='52000' />
          <zone h='48000' id='10' name='Customer Detail' w='33334' x='66666' y='52000' />
          <zone h='6000' id='11' name='Sales Trend' pane-specification-id='0' param='[federated.0a1b2c3].[none:Segment:nk]' type-v2='color' w='20000' x='80000' y='0' is-floating='true' />
          <zone h='6000' id='12' type-v2='web' w='10000' x='0' y='94000' />
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <actions>
    <action caption='Filter by Region' name='[Action1]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Executive Overview' type='sheet' worksheet='Sales by Region' />
      <command command='tsc:tsl-filter'>
        <param name='special-fields' value='all' />
        <param name='target' value='Executive Overview' />
      </command>
    </action>
    <action caption='Highlight Category' name='[Action2]'>
      <activation type='on-hover' />
      <source dashboard='Executive Overview' type='sheet' worksheet='Category Mix' />
      <command command='tsc:brush'>
        <param name='target' value='Executive Overview' />
      </command>
    </action>
    <action caption='Open CRM' name='[Action3]'>
      <activation type='on-menu' />
      <source dashboard='Executive Overview' type='sheet' worksheet='Customer Detail' />
      <command command='tsc:url'>
        <param name='url' value='https://crm.example.com/customer/&lt;Customer Name&gt;' />
      </command>
    </action>
  </actions>
</workbook>
